Logical:  XDMActorSystem
Parent: xdmActorXdsCore
Id: xdmActorSystem
Title: "XDM ActorSystem"
Description: """
Cet attribut représente l'acteur System.
"""


* xcn1 only SystIdNat
* xcn1 ^example.label = "système avec un identifiant interne dans une structure de santé FINESS"
* xcn1 ^example.valueString = "3750100125/88"
* xcn2 ^short = "Nom et version du système"
* xcn3 ^short = "Nom du modèle pour les dispositifs ou dénomination pour les autres systèmes."
* xcn9.composant2   = "1.2.250.1.71.4.2.1"
* xcn10 = #U
* xcn13 = #RI

