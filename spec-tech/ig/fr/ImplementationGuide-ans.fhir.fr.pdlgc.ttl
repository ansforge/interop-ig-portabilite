       fhir:ImplementationGuide.definition.resource.name [ fhir:value "PDLGC Archive Portabilite" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "L'archive de Portabilité est un conteneur structuré, regroupant l'ensemble des documents et données LGC exportées ainsi que les éléments de métadonnées, d'index et de documentation nécessaires à leur exploitation par le destinataire. Convention de nommage : PAAAAAMMJJThhmmss.ZIP, avec PA = préfixe, AAAAMMJJThhmmss = horodatage" ] ;
