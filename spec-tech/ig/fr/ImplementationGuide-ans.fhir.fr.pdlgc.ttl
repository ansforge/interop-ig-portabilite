       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "XDM PatientId" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Modèle logique de patientID.\nPatientID représente l’identifiant du patient, en l’occurrence, le matricule INS (NIR ou NIA) du patient." ] ;
