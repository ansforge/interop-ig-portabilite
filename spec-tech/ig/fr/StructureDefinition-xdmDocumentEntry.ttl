         fhir:index -1 ;
         fhir:ElementDefinition.mapping.identity [ fhir:value "DocumentEntryCDA" ] ;
         fhir:ElementDefinition.mapping.map [ fhir:value "code@code (classCode est déduit de typeCode selon la table de correspondance entre ces deux métadonnées référencée dans les Nomenclatures des Objets de Santé (NOS) : ASS_X04-CorrespondanceType-Classe)" ]
       ]
     ], [
