     fhir:StructureDefinition.snapshot.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "pdlgc-editeur-sortant" ] ;
       fhir:ElementDefinition.path [ fhir:value "pdlgc-editeur-sortant" ] ;
       fhir:ElementDefinition.short [ fhir:value "PDLGC Editeur Sortant" ] ;
