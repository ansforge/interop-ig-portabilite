       fhir:ElementDefinition.short [ fhir:value "Nom, sous sa forme la plus longue et complète, sous lequel l'entité géographique exerce son activité (acronymes, sigles ou abréviations développés)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nom, sous sa forme la plus longue et complète, sous lequel l'entité géographique exerce son activité (acronymes, sigles ou abréviations développés)." ] ;
