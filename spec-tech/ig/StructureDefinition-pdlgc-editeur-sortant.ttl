       fhir:ElementDefinition.short [ fhir:value "Date d’autorisation qui correspond à la date de l’arrêté autorisant la création d’un établissement ou de la première autorisation délivrée pour des équipements." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Date d’autorisation qui correspond à la date de l’arrêté autorisant la création d’un établissement ou de la première autorisation délivrée pour des équipements." ] ;
